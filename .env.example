# Public site URL (no trailing slash) — used for metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://couturehouse.co

# Resend — get a key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=hello@couturehouse.co

# From address for outgoing transactional email
# For testing: "Couture House <onboarding@resend.dev>"
# For production: verify your domain in Resend, then use a sender on it
CONTACT_FROM_EMAIL=Couture House <onboarding@resend.dev>
