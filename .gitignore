# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# content-drop is a staging area — track docs but never commit binary content
/content-drop/**/*.mp4
/content-drop/**/*.mov
/content-drop/**/*.webm
/content-drop/**/*.m4v
/content-drop/**/*.jpg
/content-drop/**/*.jpeg
/content-drop/**/*.png
/content-drop/**/*.webp
/content-drop/**/*.avif
/content-drop/**/*.heic
/content-drop/**/*.gif
/content-drop/**/*.svg
/content-drop/**/*.ico
/content-drop/**/*.mp3
/content-drop/**/*.wav
/content-drop/**/*.aac
/content-drop/**/*.zip
